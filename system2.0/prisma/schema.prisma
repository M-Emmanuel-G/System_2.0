generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccountUser {
  id    String     @id @default(cuid()) 
  email String  @unique
  name  String
  password String
  dvrID String
}

model Clients{
  id String @id @default(cuid())
  client String
  date String
  dvr Dvr[]

}

model Dvr{
  id String @id @default(cuid())
  name_Client String @default("Nome do cliente")
  description String @default("Descricao/Localizacao DVR")
  model String @default("modelo")
  cams_installed String @default("cameras instaladas")
  user String @default("usuario")
  password String @default("senha")
  ip String @default("ip")
  cloud String @default("cloud")
  service_port String @default("porta servico")
  http_port String @default("porta http")
  ddns String @default("ddns")
  hd String @default("Tamanho HD")
  recording_days String @default("Dias de gravacao")

  clientID String
  clients Clients @relation(fields: [clientID], references: [id])
}

model Solicities{
  id String @id @default(cuid())
  client String
  cod_solicity Int @default(autoincrement())
  solicity_type String @default("Orçamento")
  solicity String
  description String
}

model Materials{
  id String @id @default(cuid())
  client String
  description String
}